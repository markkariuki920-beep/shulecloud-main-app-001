# Central cloud-provider selection. Supabase is currently the only implemented provider.
CLOUD_PROVIDER=supabase

# Generic names are preferred for future provider migrations.
VITE_CLOUD_API_URL=https://YOUR_PROJECT.supabase.co
VITE_CLOUD_PUBLIC_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
CLOUD_API_URL=https://YOUR_PROJECT.supabase.co
CLOUD_PUBLIC_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
CLOUD_SERVICE_KEY=YOUR_PRIVATE_SUPABASE_SERVICE_ROLE_KEY

# Legacy Supabase names remain supported as fallbacks for existing deployments.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PROJECT_ID=YOUR_SUPABASE_PROJECT_ID
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_PRIVATE_SERVICE_ROLE_KEY
# Set this only as a private server-side Cloudflare Pages variable; never commit the real email.
SUPER_ADMIN_EMAIL=
INTEGRATIONS_ENCRYPTION_KEY=REPLACE_WITH_A_SECURE_RANDOM_SECRET
SHULECLOUD_CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Optional old secret during a controlled scheduler-secret rotation.
SHULECLOUD_CRON_SECRET_PREVIOUS=

# Required for Google Drive OAuth and secure callback URLs.
APP_URL=https://YOUR_PUBLISHED_APP_DOMAIN
GOOGLE_DRIVE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_DRIVE_CLIENT_SECRET=YOUR_PRIVATE_GOOGLE_OAUTH_CLIENT_SECRET

# Required for server-side invitation email delivery.
RESEND_API_KEY=YOUR_RESEND_API_KEY
EMAIL_FROM=ShuleCloud <no-reply@YOUR_VERIFIED_DOMAIN>

# Optional private PostgreSQL connection string, only for running Drizzle migrations locally.
# DATABASE_URL=postgresql://...
